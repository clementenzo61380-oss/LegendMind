DISCORD_TOKEN=
COC_EMAIL=
COC_PASSWORD=
# Local : localhost. Avec docker compose, ce DSN est surchargé par docker-compose.yml.
DATABASE_URL=postgresql://legendmind:legendmind@localhost:5432/legendmind_v3
# Sur Railway, SSL vers Postgres est activé automatiquement (ou force avec DATABASE_SSL=true / false).
# DATABASE_SSL=false
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=180
POLL_QUEUE_MAX=2000
ALERT_COOLDOWN_DEFAULT_SECONDS=3600

# ─── Stripe (Premium) ────────────────────────────────────────────────────────
# Laisse vide pour désactiver complètement /premium et le webhook.
# Voir docs/STRIPE_SETUP.md pour le pas-à-pas (Cloudflare Tunnel + Dashboard).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=https://discord.com/channels/@me
STRIPE_CANCEL_URL=https://discord.com/channels/@me

# ─── Serveur HTTP webhook (Stripe) ───────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ─── Tuning Legend (optionnel, JSON hébergé après lecture des patch notes) ─
# GAME_TUNING_URL=https://example.com/legendmind-game-tuning.json
# GAME_TUNING_POLL_SECONDS=86400

# IDs Discord (séparés par virgule ou espace) = Premium à vie sur cette instance, sans Stripe.
# LIFETIME_ENTITLED_DISCORD_IDS=123456789012345678,987654321098765432

# ─── Export Excel quotidien (Légende : attaques, défenses, net trophées) ────
# Déclenché chaque jour à legend_daily_reset_hour_utc (tuning JSON / constantes) + N minutes.
# Ex. reset jeu à 19h Paris → régler legend_daily_reset_hour_utc (souvent 17–18 UTC selon l’heure).
# DAILY_LEGEND_EXPORT_ENABLED=true
# DAILY_LEGEND_EXPORT_MINUTE_AFTER_RESET=5
# DAILY_LEGEND_EXPORT_XLSX_PATH=data/daily_legend_stats.xlsx
# DAILY_LEGEND_EXPORT_STATE_PATH=data/.daily_legend_export_last
# DAILY_LEGEND_EXPORT_DISCORD_CHANNEL_ID=
