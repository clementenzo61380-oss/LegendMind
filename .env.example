# ─── Obligatoires ───────────────────────────────────────────────────────────
DISCORD_TOKEN=
COC_EMAIL=
COC_PASSWORD=

# Local (hors Docker) : localhost. Avec `docker compose`, DATABASE_URL est surchargée dans docker-compose.yml.
# Sur Railway : NE PAS utiliser localhost — crée « New » → PostgreSQL, puis dans ton service Variables
# référence DATABASE_URL du plugin (ou colle l'URL `postgres.railway.internal` / publique fournie).
DATABASE_URL=postgresql://legendmind:legendmind@localhost:5432/legendmind_v3

# Local / Docker desktop : false. Railway ou Postgres managé : true ou laisser auto (RAILWAY_ENVIRONMENT).
DATABASE_SSL=false

# Debug NDJSON optionnel (Cursor / dev). Vide = désactivé (recommandé en prod).
# AGENT_DEBUG_NDJSON_PATH=/chemin/vers/debug.ndjson
# Alias accepté : AGENT_DEBUG_MAIN

# Slash : éviter les doublons (global + guild) → guild en prod.
# SLASH_SYNC_MODE=guild
# Une fois : purger les commandes GLOBAL chez Discord puis remettre false.
# SLASH_PURGE_GLOBAL=false

# ─── Logs & polling ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=180
POLL_QUEUE_MAX=2000
ALERT_COOLDOWN_DEFAULT_SECONDS=3600

# ─── Stripe (optionnel — laisser vide = pas de paiement / webhook) ───────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=https://discord.com/channels/@me
STRIPE_CANCEL_URL=https://discord.com/channels/@me

# ─── HTTP (Stripe webhook + /health) ────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
# Local : 8000. Si « address already in use », mets 8001 ou arrête l’autre process.
# Railway : laisser vide pour utiliser PORT injecté par la plateforme.
WEBHOOK_PORT=8000

# ─── Tuning jeu (optionnel — JSON distant, surcharge constants / reset UTC) ─
# GAME_TUNING_URL=https://example.com/legendmind-game-tuning.json
# GAME_TUNING_POLL_SECONDS=86400

# ─── Premium à vie (IDs Discord, espaces ou virgules) ───────────────────────
# LIFETIME_ENTITLED_DISCORD_IDS=

# ─── Export PDF quotidien (reset = LEGEND_DAILY_RESET_HOUR_UTC + minute) ────
# Défaut code : reset 17h UTC (~19h Paris CEST). PDF : data/daily_legend_stats.pdf
# Historique cumulatif (JSONL) : défaut data/daily_legend_stats_history.jsonl si vide.
DAILY_LEGEND_EXPORT_ENABLED=true
DAILY_LEGEND_EXPORT_MINUTE_AFTER_RESET=5
DAILY_LEGEND_EXPORT_PDF_PATH=data/daily_legend_stats.pdf
# DAILY_LEGEND_EXPORT_HISTORY_PATH=
DAILY_LEGEND_EXPORT_STATE_PATH=data/.daily_legend_export_last
# ID numérique du salon texte pour recevoir le PDF (vide = fichier seulement)
DAILY_LEGEND_EXPORT_DISCORD_CHANNEL_ID=
