# ─── API Anthropic (obligatoire pour les fonctionnalités IA) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Identité de l'apporteur d'affaires (pour les contrats) ─────────────────
APPORTEUR_NOM=Jean Dupont
APPORTEUR_SIREN=123456789
APPORTEUR_ADRESSE=10 rue de la Paix, 35000 Rennes
APPORTEUR_TELEPHONE=06 12 34 56 78
APPORTEUR_EMAIL=contact@example.com

# ─── Configuration commerciale ───────────────────────────────────────────────
COMMISSION_DEFAUT=5.0
# Délai de paiement en jours après signature devis + versement acompte
DELAI_PAIEMENT_JOURS=30

# ─── Base de données (chemin relatif depuis le dossier prospector/) ──────────
DB_PATH=data/prospector.db

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000
