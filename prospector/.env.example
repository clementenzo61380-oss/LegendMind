# ─── API Anthropic (obligatoire pour les fonctionnalités IA) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Identité de l'apporteur d'affaires (pour les contrats) ─────────────────
APPORTEUR_NOM=Jean Dupont
APPORTEUR_SIREN=123456789
APPORTEUR_ADRESSE=10 rue de la Paix, 35000 Rennes
APPORTEUR_TELEPHONE=06 12 34 56 78
APPORTEUR_EMAIL=contact@example.com

# ─── Configuration commerciale ───────────────────────────────────────────────
COMMISSION_DEFAUT=5.0
# Délai de paiement en jours après signature devis + versement acompte
DELAI_PAIEMENT_JOURS=30

# ─── Auto-prospection (veille open data en tâche de fond) ───────────────────
# L'app interroge automatiquement l'open data Sitadel toutes les N heures,
# importe les nouveaux permis (dédupliqués) et qualifie ceux à fort score.
# ⚠️ Open data uniquement — aucun scraping, aucun envoi automatique de message.
AUTO_PROSPECT_ENABLED=true
AUTO_PROSPECT_INTERVAL_HOURS=6
AUTO_PROSPECT_COMMUNE=Rennes
AUTO_PROSPECT_DEPT=35
AUTO_PROSPECT_LIMIT=30
# Score à partir duquel un lead passe automatiquement en "qualifié"
AUTO_QUALIFY_SCORE=70

# ─── Base de données (chemin relatif depuis le dossier prospector/) ──────────
DB_PATH=data/prospector.db

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000
